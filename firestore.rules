rules_version = '2';
// 이 사이트가 쓰는 5개 컬렉션만 읽기/쓰기를 허용합니다.
// 주의: 로그인 없는 정적 사이트이므로 주소를 아는 사람은 데이터를 읽고 쓸 수 있습니다.
// 외부 공개 운영 전에는 Firebase Authentication 도입을 권장합니다 (README 참고).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read, write: if col in ['config', 'cats', 'avail', 'days', 'bookings'];
    }
  }
}
